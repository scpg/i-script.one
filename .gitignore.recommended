# .gitignore for i-script.one
# Optimized for PowerShell/Windows development with Excel data conversion
# Generated: 2025-11-20

#######################################
# POWERSHELL & WINDOWS SPECIFIC
#######################################

# PowerShell execution policy and profiles
*.ps1xml
Microsoft.PowerShell_profile.ps1
Microsoft.PowerShellISE_profile.ps1

# PowerShell transcripts and temporary files
PowerShell_transcript.*
*.tmp
*.temp
*~

# PowerShell cache and module artifacts
*.cache
PSGetModuleInfo.xml

# Windows system files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Windows installer files
*.cab
*.msi
*.msm
*.msp

#######################################
# DEVELOPMENT TOOLS
#######################################

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains IDEs
.idea/
*.sln.iml

# Claude Code settings (user-specific)
.claude/settings.local.json
.claude/user-*

#######################################
# BUILD & TEST OUTPUTS
#######################################

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Test results (but NOT test data)
TestResults/
*.trx
*.coverage
coverage/

# Generated test outputs (dynamically created)
ps/excel/ConvertFromExcel/test-output/*.csv
ps/excel/ConvertFromExcel/test-output/*.json
ps/excel/ConvertFromExcel/test-output/*.txt
ps/excel/ConvertFromExcel/test-output/*.yaml
ps/excel/ConvertFromExcel/test-output/*.yml

# BUT keep test output .gitignore file itself
!ps/excel/ConvertFromExcel/test-output/.gitignore

#######################################
# DEPENDENCIES & PACKAGES
#######################################

# Node.js (if used for tooling)
node_modules/
*.lock

# NuGet packages
*.nupkg
*.snupkg
.nuget/
packages/
project.lock.json
project.fragment.lock.json
artifacts/

#######################################
# LOGS & RUNTIME DATA
#######################################

# Logs
logs/
*.log
*.log.*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

#######################################
# CONFIGURATION & SECRETS
#######################################

# Environment variables
.env
.env.local
.env.production
.env.test

# Local configuration
*.local.json
appsettings.local.json
local.settings.json

# Secrets and keys
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json

#######################################
# CLOUD & AZURE
#######################################

# Microsoft Azure
csx/
*.build.csdef
ecf/
rcf/

#######################################
# DATABASES & TEMPORARY FILES
#######################################

# Database files
*.db
*.sqlite
*.sqlite3

# Backup files
*.bak
*.backup

# Temporary folders
tmp/
temp/

#######################################
# ARCHIVES & BINARIES
#######################################

# Archives (except test data)
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# BUT allow specific test archives if needed
# !test-data/**/*.zip

#######################################
# OS SPECIFIC
#######################################

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

#######################################
# PROJECT SPECIFIC EXCEPTIONS
#######################################

# IMPORTANT: Keep all test data for validation
# Test Excel files are essential for module testing
!ps/excel/ConvertFromExcel/test-data/
!ps/excel/ConvertFromExcel/test-data/*.xlsx
!ps/excel/ConvertFromExcel/test-data/*.xls
!ps/excel/ConvertFromExcel/test-data/*.xlsm
!ps/excel/ConvertFromExcel/test-data/*.xlsb

# Keep expected test output samples (for validation)
!ps/excel/ConvertFromExcel/test-output/expected/
!ps/excel/ConvertFromExcel/test-output/expected/*.json
!ps/excel/ConvertFromExcel/test-output/expected/*.csv

# Keep AI instruction files (should be tracked)
!AI_INSTRUCTIONS.md
!PROJECT_SUMMARY.md
!.github/AI_CONTEXT.md
!.github/COPILOT_INSTRUCTIONS.md

# Keep backlog management files
!ps/excel/ConvertFromExcel/backlog/
!ps/excel/ConvertFromExcel/backlog/**/*.md
!ps/excel/ConvertFromExcel/backlog/**/*.yml

#######################################
# GLOBAL CSV/JSON POLICY
#######################################

# By default, ignore CSV files (often generated outputs)
*.csv

# BUT allow CSV files in specific locations:
!test-data/**/*.csv
!documentation/**/*.csv
!examples/**/*.csv

# Allow JSON configuration files but ignore generated JSON
*.json
!package.json
!tsconfig.json
!.vscode/*.json
!.claude/*.json
!**/config.json
!**/settings.json
!**/*config*.json