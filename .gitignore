# ── keys and secrets ─────────────────────────────────────────────────────────
*.key
*.pem
*.crt
*.cert
*.p12
*.pfx
*.p8
*.der
*.secret
*.token
secrets/
credentials/

# ── .env (environment variables), virtual environments ───────────────────────
.env*
!.env.example
!.env.template
!.env.op
!.env.1p

.venv*

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/settings.local.json

# ── logs ──────────────────────────────────────────────────────────────────────
# *.log is acceptable here — scripts write to syslog, not project files.
# If you need to track a specific .log file, override with !path/to/file.log
*.log

# ── *.local directories (scratch/local-only at any depth) ────────────────────
# Contents are ignored; the directory itself is tracked via .gitkeep or .keep.
**/*.local/*
!.gitkeep
!.keep

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Linux ─────────────────────────────────────────────────────────────────────
*~

# ── editors ───────────────────────────────────────────────────────────────────
*.swp
*.swo
.idea/
.vscode/

# ── backup / patch leftovers ──────────────────────────────────────────────────
*.bak
*.orig
*.rej
