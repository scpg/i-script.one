# ── keys and secrets ─────────────────────────
*.key
*.pem
*.crt
*.cert

# ── .env (environment variables), virtual environments ─────────────────────────
.env*
!.env.example
!.env.template
!.env.op
!.env.1p

.venv*

# ── logs ──────────────────────────────────────────────────────────────────────
*.log

# ── *.local directories (scratch/local-only at any depth) ────────────────────
# Contents are ignored; the directory itself is tracked via .gitkeep or .keep.
**/*.local/*
!.gitkeep
!.keep

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Linux ─────────────────────────────────────────────────────────────────────
*~

# ── editors ───────────────────────────────────────────────────────────────────
*.swp
*.swo
.idea/
