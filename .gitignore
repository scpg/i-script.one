# PowerShell and Windows specific ignores

# PowerShell execution policy and profiles
*.ps1xml
Microsoft.PowerShell_profile.ps1
Microsoft.PowerShellISE_profile.ps1

# PowerShell transcripts
PowerShell_transcript.*

# Temporary PowerShell files
*.tmp
*.temp
*~

# PowerShell cache files
*.cache

# Windows image file caches
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

